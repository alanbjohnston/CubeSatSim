	else
	  grep 'changed' /home/pi/CubeSatSim/.updated
	  if [[ $(grep 'changed' /home/pi/CubeSatSim/.updated) ]]; then
	    echo "reboot due to code changes " | wall
	    sudo reboot -h now
#    sudo  cubesatsim
	  else
	    echo "nothing to do."
	  fi  
	fi
else
	if [ $FLAG -eq 1 ]; then
		echo "reboot needed for changes to take effect" | wall
	fi
fi
